{
  "name": "amm-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous Solana market-making suite (PumpSwap / Raydium / Orca / Meteora / Phoenix)",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "treasury"
  ],
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' --filter='./treasury' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "cli": "pnpm --filter @amm/cli start",
    "web": "pnpm --filter @amm/web dev",
    "treasury": "pnpm --filter @amm/treasury start",
    "treasury:dev": "pnpm --filter @amm/treasury exec node --import tsx/esm src/cli.ts start -c ../treasury.config.json",
    "clean": "pnpm -r exec rimraf dist node_modules .next .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
