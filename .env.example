# --- RPC Endpoints (rotation pool) ---
# At least one is required. Add as many as you want; the manager will rotate and load-balance.
RPC_HELIUS=
RPC_TRITON=
RPC_QUICKNODE=
RPC_PUBLIC=https://api.mainnet-beta.solana.com
RPC_WS_HELIUS=
RPC_WS_PUBLIC=wss://api.mainnet-beta.solana.com

# --- Jito (block-engine for atomic bundles + tips) ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000

# --- Optional Tor SOCKS5 proxy ---
# If set, all RPC calls and outbound HTTP will route through Tor.
TOR_PROXY=
# Example: TOR_PROXY=socks5h://127.0.0.1:9050

# --- Vault ---
# Where the encrypted wallet vault is stored. Defaults to ~/.amm/vault.enc
VAULT_PATH=
# If set, the vault passphrase will be read from this env var instead of being prompted.
# WARNING: only use for headless / scripted runs. Prompted is more secure.
VAULT_PASSPHRASE=

# --- Web dashboard ---
WEB_HOST=127.0.0.1
WEB_PORT=4317

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true
