# --- MAINNET production environment ---
# This is the real Solana. Real money. Be careful.
#
# How to use this file:
#   1. Copy values into your shell (PowerShell), OR
#   2. Load with `pnpm dlx dotenv-cli -e .env.mainnet -- <command>`
#
# DO NOT commit this file with real keys filled in (it's already in .gitignore).

# Tells the Meteora DLMM SDK to use the mainnet program deployment.
SOLANA_CLUSTER=mainnet-beta

# --- RPC Endpoints (rotation pool) ---
# At least one PRIVATE endpoint is required for any real run.
# Public mainnet RPC is rate-limited and unreliable - leave it as fallback only.

# Paste your Helius URL here, e.g.:
# RPC_HELIUS=https://mainnet.helius-rpc.com/?api-key=11111111-2222-3333-4444-555555555555
RPC_HELIUS=

# Optional second/third providers - the manager rotates between them for OPSEC.
RPC_TRITON=
RPC_QUICKNODE=

# Public fallback (don't rely on it).
RPC_PUBLIC=https://api.mainnet-beta.solana.com
RPC_WS_PUBLIC=wss://api.mainnet-beta.solana.com

# Helius websocket (highly recommended - swap-confirmation latency drops a lot)
# RPC_WS_HELIUS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WS_HELIUS=

# --- Jupiter (volume / aggregator swaps) ---
# JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
# If you see simulation `AccountNotFound` on some wallets only, try:
# JUPITER_USE_SHARED_ACCOUNTS=false

# --- Jito (block-engine for atomic bundles + MEV protection) ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000

# --- Optional Tor SOCKS5 proxy ---
# If set, all RPC calls and outbound HTTP will route through Tor.
TOR_PROXY=

# --- Optional: Tor control port for automatic NEWNYM circuit rotation on 429 ---
# When the RPC layer hits "Too Many Requests" (your Tor exit IP got rate-limited
# by Helius/Jupiter), the manager will SIGNAL NEWNYM to rotate exit nodes if these
# are set. Tor Browser bundle: SOCKS 9150 / Control 9151; cookie file inside the
# bundle's Data\Tor\ directory.
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=
TOR_CONTROL_COOKIE=
# Alternative to cookie auth (matches `HashedControlPassword` in torrc):
TOR_CONTROL_PASSWORD=

# --- Vault ---
# SEPARATE vault from devnet. Never share a vault between mainnet + devnet.
VAULT_PATH=./.amm-mainnet/vault.enc

# Leave the passphrase BLANK and let the bot prompt for it interactively.
# Setting VAULT_PASSPHRASE in env defeats the encryption when someone reads
# your shell history / process list. Only acceptable for fully-headless runs.
VAULT_PASSPHRASE=

# --- Web dashboard ---
WEB_HOST=127.0.0.1
WEB_PORT=4317

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true
