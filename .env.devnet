# --- Devnet test environment ---
# Copy this to `.env` (or load with `pnpm dotenv -e .env.devnet -- ...`) when
# you want to point the bot at Solana devnet.

# Tells the Meteora DLMM SDK to use the devnet program deployment.
SOLANA_CLUSTER=devnet

# --- RPC Endpoints ---
# Public devnet RPC. Add a Helius / Triton devnet endpoint for higher throughput.
RPC_PUBLIC=https://api.devnet.solana.com
RPC_WS_PUBLIC=wss://api.devnet.solana.com
# RPC_HELIUS=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Jito (mainnet only - leave blank on devnet) ---
JITO_BLOCK_ENGINE_URL=
JITO_TIP_LAMPORTS=0

# --- Tor SOCKS5 (off for devnet testing) ---
TOR_PROXY=

# --- Vault ---
# Use a SEPARATE vault path for devnet so you never confuse it with mainnet keys.
VAULT_PATH=./.amm-devnet/vault.enc
# For non-interactive setup, set a passphrase here. Remove for prompted unlock.
VAULT_PASSPHRASE=devnet-test-pass

# --- Web dashboard ---
WEB_HOST=127.0.0.1
WEB_PORT=4317

# --- Logging ---
LOG_LEVEL=debug
LOG_PRETTY=true
