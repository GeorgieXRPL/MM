{
  "name": "@amm/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "amm": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx/esm src/index.ts",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@amm/core": "workspace:*",
    "@amm/orchestrator": "workspace:*",
    "@amm/shared": "workspace:*",
    "@amm/strategies": "workspace:*",
    "@amm/venues": "workspace:*",
    "@inquirer/prompts": "^7.0.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
